#!/usr/bin/env python3
"""SindhOS keyboard menu, opened from the taskbar keyboard indicator.

A plain GTK menu (closes when you click outside it, unlike the IBus tray
menu) with the three keyboards and the Sindhi Keyboard Guide.
"""
import subprocess

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

KEYBOARDS = [("xkb:us::eng", "English"), ("sindhos-roman", "Roman Sindhi"), ("sindhos-sindhi", "سنڌي")]


def refresh_indicator():
    subprocess.run(["xfce4-panel", "--plugin-event=genmon-10:refresh:bool:true"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def choose(engine):
    subprocess.run(["ibus", "engine", engine])
    refresh_indicator()


def main():
    current = subprocess.run(["ibus", "engine"], capture_output=True, text=True).stdout.strip()
    menu = Gtk.Menu()
    group = None
    for engine, label in KEYBOARDS:
        item = Gtk.RadioMenuItem.new_with_label_from_widget(group, label)
        group = item
        item.set_active(engine == current)
        item.connect("activate", lambda w, e=engine: w.get_active() and choose(e))
        menu.append(item)
    menu.append(Gtk.SeparatorMenuItem())
    guide = Gtk.MenuItem.new_with_label("Keyboard Guide · ڪيبورڊ رهنمائي")
    guide.connect("activate", lambda *_: subprocess.Popen(
        ["firefox-esr", "/usr/share/sindhos/keyboard-guide/index.html"]))
    menu.append(guide)
    menu.connect("deactivate", lambda *_: GLib.timeout_add(200, Gtk.main_quit))
    menu.show_all()

    # Open at the mouse pointer (the taskbar indicator that was clicked).
    seat = Gdk.Display.get_default().get_default_seat()
    _screen, x, y = seat.get_pointer().get_position()
    rect = Gdk.Rectangle()
    rect.x, rect.y, rect.width, rect.height = x, y, 1, 1
    root = Gdk.get_default_root_window()
    menu.popup_at_rect(root, rect, Gdk.Gravity.NORTH_WEST, Gdk.Gravity.SOUTH_WEST, None)
    Gtk.main()


if __name__ == "__main__":
    main()
