#!/bin/sh
# Sindhi Linux setup, runs inside the image while it is being built.
set -e

# 1. Languages: English, Sindhi (Arabic script) and Urdu
for loc in "en_US.UTF-8 UTF-8" "sd_IN UTF-8" "ur_PK UTF-8"; do
  sed -i "s/^# *${loc}/${loc}/" /etc/locale.gen
  grep -q "^${loc}" /etc/locale.gen || echo "${loc}" >> /etc/locale.gen
done
locale-gen
update-locale LANG=en_US.UTF-8

# 2. Boot splash: ajrak logo with the Sindhi welcome
plymouth-set-default-theme sindhi
update-initramfs -u -k all

# 3. Desktop wallpaper
update-alternatives --install /usr/share/images/desktop-base/desktop-background \
  desktop-background /usr/share/backgrounds/sindhi/wallpaper.png 100
update-alternatives --set desktop-background /usr/share/backgrounds/sindhi/wallpaper.png

# 3b. XFCE ships its own default wallpaper, replace those too
for img in /usr/share/backgrounds/xfce/*; do
  [ -f "$img" ] || continue
  dpkg-divert --quiet --local --rename --add "$img"
  case "$img" in
    *.svg) cp /usr/share/backgrounds/sindhi/wallpaper.svg "$img" ;;
    *)     cp /usr/share/backgrounds/sindhi/wallpaper.png "$img" ;;
  esac
done

# 3c. Installer icon on the desktop
for f in $(grep -rl "Install Debian" /usr/share/applications 2>/dev/null); do
  sed -i -e '/^Name\[/d' -e '/^GenericName\[/d' -e '/^Comment\[/d' \
    -e 's/^Name=.*/Name=Install Sindhi Linux/' \
    -e 's/^Icon=.*/Icon=\/usr\/share\/pixmaps\/sindhi-linux.png/' "$f"
done

# 3d. Roman Sindhi keyboard defaults (IBus settings)
glib-compile-schemas /usr/share/glib-2.0/schemas

# 4. System name
for f in /usr/lib/os-release /etc/os-release; do
  [ -f "$f" ] && [ ! -L "$f" ] || continue
  sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Sindhi Linux (Debian 13 base)"/' "$f"
done
