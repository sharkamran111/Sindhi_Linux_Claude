#!/bin/sh
# SindhOS ISO build, installed by tools/setup-build-host.sh as
# /usr/local/sbin/sindhos-build. Runs as root.
#
#   sindhos-build            test build (fast zstd squashfs)
#   sindhos-build --release  release build (xz squashfs)
#   sindhos-build --clean    remove everything from earlier builds except the
#                            downloaded package cache, then stop
#
# Copies the checkout at @REPO@ into the Debian build chroot @ROOT@, runs
# ./build.sh there with Debian's live-build, and puts the ISO and the build
# log in @REPO@/out/.
set -eu

REPO=@REPO@
ROOT=@ROOT@
WORK=$ROOT/work
OUT=$REPO/out

MODE=test
case "${1:-}" in
  "") ;;
  --release) MODE=release ;;
  --clean) MODE=clean ;;
  *) echo "usage: sindhos-build [--release|--clean]" >&2; exit 2 ;;
esac

[ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 1; }
[ -x "$ROOT/usr/bin/lb" ] || { echo "build chroot missing, run tools/setup-build-host.sh" >&2; exit 1; }
[ -f "$REPO/build.sh" ] || { echo "no build.sh in $REPO" >&2; exit 1; }

# Unmount everything below a directory, deepest first.
unmount_below() {
  findmnt -rno TARGET | grep -E "^$1(/|$)" | sort -r | while read -r m; do
    umount -l "$m" 2>/dev/null || true
  done
}

cleanup() {
  unmount_below "$WORK"
  for m in dev/pts dev sys proc; do umount -l "$ROOT/$m" 2>/dev/null || true; done
}
trap cleanup EXIT INT TERM

# A crashed earlier build can leave mounts behind; never copy or delete over them.
unmount_below "$WORK"

if [ "$MODE" = clean ]; then
  # Keep only live-build's downloaded packages (slow to fetch again).
  if [ -d "$WORK" ]; then
    find "$WORK" -mindepth 1 -maxdepth 1 ! -name cache -exec rm -rf {} +
    if [ -d "$WORK/cache" ]; then
      find "$WORK/cache" -mindepth 1 -maxdepth 1 \
        ! -name 'packages.*' ! -name 'contents.*' -exec rm -rf {} +
    fi
  fi
  rm -f "$OUT"/*.iso "$OUT"/build-*.log "$OUT"/build.log
  echo "Cleaned. Kept the package cache:"
  du -sh "$WORK"/cache/* 2>/dev/null || echo "  (empty)"
  exit 0
fi

mkdir -p "$WORK" "$OUT"

# eatmydata in the build chroot (older setups don't have it yet)
cp -L /etc/resolv.conf "$ROOT/etc/resolv.conf"
if [ ! -e "$ROOT/usr/bin/eatmydata" ]; then
  echo "Installing eatmydata in the build chroot..."
  chroot "$ROOT" sh -c 'DEBIAN_FRONTEND=noninteractive apt-get install -y -qq eatmydata' >/dev/null
fi

# Copy the source (including uncommitted changes). Excluded paths are left
# alone on the build side: live-build's package cache and build dirs
# (build.sh cleans those itself).
rsync -a --delete \
  --exclude=/.git/ --exclude=/out/ --exclude=/shots/ --exclude='*.iso' \
  --exclude=/cache/ --exclude=/chroot/ --exclude=/binary/ --exclude=/.build/ \
  "$REPO/" "$WORK/"
# Your local download files (top level of cache/ only, e.g. firmware) go
# next to live-build's own cache folders, never replacing them.
mkdir -p "$WORK/cache"
if [ -d "$REPO/cache" ]; then
  find "$REPO/cache" -maxdepth 1 -type f -exec cp {} "$WORK/cache/" \;
fi

mount -t proc proc "$ROOT/proc"
mount -t sysfs sys "$ROOT/sys"
mount --bind /dev "$ROOT/dev"
mount --bind /dev/pts "$ROOT/dev/pts"

BUILD_ARGS=
[ "$MODE" = release ] && BUILD_ARGS=--release

STAMP=$(date +%Y%m%d-%H%M%S)
LOG=$OUT/build-$STAMP.log
echo "Building ($MODE)... log: $LOG"
start=$(date +%s)
if chroot "$ROOT" /bin/sh -c "cd /work && chmod +x build.sh config/hooks/normal/*.hook.chroot && ./build.sh $BUILD_ARGS" > "$LOG" 2>&1; then
  status=0
else
  status=$?
fi
mins=$(( ($(date +%s) - start) / 60 ))

owner=$(stat -c %u:%g "$REPO")
if [ "$status" = 0 ]; then
  rm -f "$OUT"/*.iso
  for iso in "$WORK"/*.iso; do
    cp "$iso" "$OUT/"
    echo "ISO: $OUT/$(basename "$iso") ($(du -h "$iso" | cut -f1), ${mins} min)"
  done
else
  echo "BUILD FAILED after ${mins} min (exit $status). Last lines of $LOG:" >&2
  tail -n 30 "$LOG" >&2
fi
ln -sf "$(basename "$LOG")" "$OUT/build.log"
chown -R "$owner" "$OUT"
exit "$status"
